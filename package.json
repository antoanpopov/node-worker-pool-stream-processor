{
  "name": "node-worker-pool-stream-processor",
  "version": "1.0.0",
  "description": "Reference implementation for offloading high-throughput stream processing to Node.js worker threads. Includes benchmarks.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "benchmark": "tsc && node dist/benchmark/runner.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "keywords": [
    "worker-threads",
    "stream-processing",
    "benchmark",
    "nodejs",
    "typescript"
  ],
  "author": "Antoan Popov",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0"
}
